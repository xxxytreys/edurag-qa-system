# 统一换行与编码，避免 Windows / Linux 协作时产生整文件 diff
* text=auto eol=lf

*.py  text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.html text eol=lf
*.jsx text eol=lf
*.css text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制/大文件（正常不会入库，这里显式声明避免误判）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.docx binary
*.pptx binary
*.bin  binary
*.pt   binary
*.pth  binary
